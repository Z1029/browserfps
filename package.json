{
  "name": "saltline-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, editable restoration of the published Saltline browser game.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-source.mjs && node scripts/verify-archive.mjs",
    "format": "prettier --write index.html \"src/**/*.js\" src/*.css vite.config.js scripts/*.mjs scripts/lib/*.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "verify:refactor": "node scripts/verify-refactor.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.13",
    "@babel/traverse": "7.29.13",
    "prettier": "3.9.10",
    "vite": "8.3.7"
  }
}
